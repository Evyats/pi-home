server {
    listen 127.0.0.1:80 default_server;
    listen [::1]:80 default_server;
    server_name _;

    root /var/www/pi-server;
    index index.html;

    location = /todo {
        return 301 /todo/;
    }

    location /todo/api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /todo/ {
        try_files $uri $uri/ /todo/index.html;
    }

    location = /flashcards {
        return 301 /flashcards/;
    }

    location /flashcards/api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /flashcards/ {
        try_files $uri $uri/ /flashcards/index.html;
    }

    location = /geography {
        return 301 /geography/;
    }

    location /geography/ {
        try_files $uri $uri/ /geography/index.html;
    }

    location = /gym {
        return 301 /gym/;
    }

    location /gym/api/ {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /gym/ {
        try_files $uri $uri/ /gym/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
